# Finax — variables de entorno (copia a .env.local; nunca subas valores reales a Git)

# IA de AXIS. Todavía no hay ningún proveedor implementado: AXIS usa siempre el motor local.
# Cuando se añada un proveedor, sus credenciales se definirán aquí (solo servidor, nunca en el cliente).
# "false" desactiva la IA aunque exista un proveedor.
AXIS_AI_ENABLED=true

# URL pública de la rama/carpeta de datos de mercado (no es un secreto). Sin ella, la función queda desactivada.
# Producción: https://raw.githubusercontent.com/<usuario>/<repo>/market-data
# Local (tras pnpm market:light / market:deep): /market-data-local
NEXT_PUBLIC_MARKET_DATA_URL=

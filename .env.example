# Finax — variables de entorno (copia a .env.local; nunca subas valores reales a Git)

# ---------- Cliente (públicas, no secretos) ----------
# URL de la rama de datos del Market Research Engine. En producción ya está fijada en .env.production.
# Local (tras pnpm market:light / market:deep): /market-data-local
NEXT_PUBLIC_MARKET_DATA_URL=

# ---------- Servidor: IA de AXIS (solo en Netlify/servidor, nunca NEXT_PUBLIC_) ----------
# Sin AXIS_AI_PROVIDER, AXIS usa solo el motor local (0 llamadas).
# AXIS_AI_PROVIDER=gemini | groq   (cuenta free tier, sin billing ni tarjeta)
AXIS_AI_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
# Modelo opcional (por defecto: gemini-2.5-flash-lite / openai/gpt-oss-120b)
AXIS_AI_MODEL=
# "false" desactiva la IA aunque haya proveedor.
AXIS_AI_ENABLED=true
# Solo puede REDUCIR el tope diario de llamadas por instancia (máximo fijo: 40).
AXIS_AI_MAX_REQUESTS_PER_DAY=

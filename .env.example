# Finax — variables de entorno (copia a .env.local; nunca subas valores reales a Git)

# ---------- Cliente (públicas, no secretos) ----------
# URL de la rama de datos del Market Research Engine. En producción ya está fijada en .env.production.
# Local (tras pnpm market:light / market:deep): /market-data-local
NEXT_PUBLIC_MARKET_DATA_URL=

# ---------- Servidor: IA de AXIS (solo en Vercel/servidor, nunca NEXT_PUBLIC_) ----------
# Sin AXIS_AI_PROVIDER, AXIS usa solo el motor local (0 llamadas).
# Cadena: AXIS_AI_PROVIDER (principal) → AXIS_AI_FALLBACK_PROVIDER (opcional) → motor local.
# Valores: cloudflare | groq | gemini. El fallback solo se prueba ante fallos del proveedor
# (429, timeout, red, 5xx, 401/403, respuesta vacía/truncada/no JSON), nunca tras un rechazo de Decision First.
# Un proveedor sin credenciales se omite: si faltan las de Cloudflare, Groq sigue funcionando solo.
AXIS_AI_PROVIDER=cloudflare
AXIS_AI_FALLBACK_PROVIDER=groq
# Cloudflare Workers AI (POST https://api.cloudflare.com/client/v4/accounts/<CF_ACCOUNT_ID>/ai/v1/chat/completions).
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Groq (POST https://api.groq.com/openai/v1/chat/completions, Authorization: Bearer GROQ_API_KEY).
GROQ_API_KEY=
# Gemini sigue disponible como principal o fallback.
GEMINI_API_KEY=
# Modelo de cada proveedor (opcional). Por defecto: @cf/google/gemma-4-26b-a4b-it (cloudflare) ·
# openai/gpt-oss-120b (groq) · gemini-2.5-flash-lite (gemini).
AXIS_AI_MODEL_CLOUDFLARE=@cf/google/gemma-4-26b-a4b-it
AXIS_AI_MODEL_GROQ=openai/gpt-oss-20b
AXIS_AI_MODEL_GEMINI=
# HEREDADA: modelo del proveedor PRINCIPAL si no tiene variable propia. Al pasar el principal a
# cloudflare, borra esta variable en Vercel (o pon un modelo @cf/…): un modelo de Groq aquí rompería Cloudflare.
# AXIS_AI_MODEL=
# "false" desactiva la IA aunque haya proveedor.
AXIS_AI_ENABLED=true
# Solo puede REDUCIR el tope diario de llamadas por instancia (máximo fijo: 40).
AXIS_AI_MAX_REQUESTS_PER_DAY=40
# Decision First: "true" → AXIS decide (reglas) y el modelo solo expresa la decisión; ante cualquier
# fallo de validación, la misma decisión se muestra en local. Cualquier otro valor → comportamiento anterior.
AXIS_DECISION_FIRST=true

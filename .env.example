# Finax — variables de entorno (copia a .env.local; nunca subas valores reales a Git)

# Proveedor de IA de AXIS (Anthropic). Sin esta clave, AXIS usa solo el motor local.
ANTHROPIC_API_KEY=

# Desactiva la IA aunque haya clave: "false". Cualquier otro valor (o ausente) = activada.
AXIS_AI_ENABLED=true

# Modelo (opcional). Por defecto: claude-opus-5
AXIS_AI_MODEL=claude-opus-5
